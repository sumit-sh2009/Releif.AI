# ReliefAI — Unified Environment Configuration

# ── Database (PostgreSQL) ─────────────────────────────────────
DATABASE_URL=postgresql://reliefai:reliefai@localhost:5432/reliefai

# ── Webapp (Next.js) ──────────────────────────────────────────
# URL of the LangGraph flood prediction engine (Releif.ai AI-model)
AI_ENGINE_URL=http://localhost:8000

# URL of the Harsh AI disaster management service (AI-centre)
AI_CENTRE_URL=http://localhost:7860

# ── AI Engine (LangGraph / FastAPI on port 8000) ─────────────
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=
AI_ENGINE_PORT=8000

# ── AI Centre (Ollama / FastAPI on port 7860) ────────────────
# Requires Ollama running locally with llama3.2 pulled:
#   ollama serve && ollama pull llama3.2
OLLAMA_HOST=http://localhost:11434
